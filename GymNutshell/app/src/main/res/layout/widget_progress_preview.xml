<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview do widget "Progresso" no seletor de widgets (android:previewLayout, renderizado pelo launcher
  em API 31+). É estático e aproximado — nome do nível, emoji e % sobre o fundo accent, como o layout
  pequeno (2x2) — só pra dar ao usuário uma ideia do widget antes de adicionar. O widget real é
  composto em Glance (ProgressWidget.kt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tier_gym_level4"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="💪"
        android:textSize="50sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="65%"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
